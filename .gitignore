*.pyc
*.log
.DS_Store
Thumbs.db
# Tool caches
.mypy_cache/
.pytest_cache/
.ruff_cache/
.venv/
.coverage
htmlcov/

# Local junction to %USERPROFILE%.agents - do not commit the linked tree
.agents/